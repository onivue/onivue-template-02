  "cards": [
    {
      "dot": "cyan",
      "title": "Anforderungen an den Client",
      "items": [
        "Streamable HTTP auf /api/mcp — in Claude Code zwingend \"type\": \"http\"",
        "PKCE mit S256; kein API-Key, kein Cookie, kein Header von Hand",
        "CLI-Clients registrieren sich als application_type: \"native\""
      ]
    },
    {
      "dot": "violet",
      "title": "Was ausgetauscht wird",
      "items": [
        "Metadaten nach RFC 9728 (Resource) und RFC 8414 (Auth Server)",
        "client_id aus der Selbstregistrierung, RFC 7591 — nichts wird abgesprochen",
        "Token = signiertes JWT mit sub, aud=/api/mcp und scope"
      ]
    },
    {
      "dot": "emerald",
      "title": "Wer entscheidet",
      "items": [
        "Registrierung ist offen — Zugriff gibt erst die Zustimmung auf /consent",
        "Ohne offline_access kein Refresh Token: nach einer Stunde neu verbinden",
        "Trennen unter /account wirkt sofort, das Access Token läuft bis zu 1 h nach"
      ]
    }
  ]
}