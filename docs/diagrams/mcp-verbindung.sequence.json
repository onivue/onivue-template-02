  "messages": [
    {
      "id": "v1",
      "from": "agent",
      "to": "resource",
      "y": 160,
      "label": "POST /api/mcp — ohne Bearer-Token",
      "variant": "emphasis"
    },
    {
      "id": "v2",
      "from": "resource",
      "to": "agent",
      "y": 188,
      "label": "401 · WWW-Authenticate: resource_metadata=…",
      "variant": "return",
      "note": "RFC 9728: die Ablehnung sagt selbst, wo autorisiert wird — nichts wird von Hand konfiguriert."
    },
    {
      "id": "v3",
      "from": "agent",
      "to": "authz",
      "y": 216,
      "label": "GET /.well-known/oauth-protected-resource/api/mcp"
    },
    {
      "id": "v4",
      "from": "authz",
      "to": "agent",
      "y": 244,
      "label": "{ resource, authorization_servers[], scopes_supported[] }",
      "variant": "return"
    },
    {
      "id": "v5",
      "from": "agent",
      "to": "authz",
      "y": 276,
      "label": "POST /oauth2/register · application_type: \"native\""
    },
    {
      "id": "v6",
      "from": "authz",
      "to": "agent",
      "y": 304,
      "label": "client_id — Dynamic Client Registration (RFC 7591)",
      "variant": "return"
    },
    {
      "id": "v7",
      "from": "agent",
      "to": "browser",
      "y": 332,
      "label": "öffnet /oauth2/authorize · code_challenge (S256) + scope",
      "variant": "emphasis"
    },
    {
      "id": "v8",
      "from": "browser",
      "to": "authz",
      "y": 360,
      "label": "Login + Zustimmung auf /consent",
      "variant": "security",
      "note": "Die signierte Query geht byte-genau zurück (ba_param), sonst verifiziert die Signatur nicht mehr."
    },
    {
      "id": "v9",
      "from": "authz",
      "to": "db",
      "y": 388,
      "label": "speichert oauth_client · oauth_consent"
    },
    {
      "id": "v10",
      "from": "authz",
      "to": "agent",
      "y": 420,
      "label": "302 redirect_uri?code=… · Code, einmalig",
      "variant": "return"
    },
    {
      "id": "v11",
      "from": "agent",
      "to": "authz",
      "y": 448,
      "label": "POST /oauth2/token · code + code_verifier",
      "variant": "emphasis"
    },
    {
      "id": "v12",
      "from": "authz",
      "to": "agent",
      "y": 476,
      "label": "access_token (JWT: sub, aud=/api/mcp, scope) + refresh_token",
      "variant": "security"
    }
  ],
