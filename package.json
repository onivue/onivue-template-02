{
	"name": "onivue",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"build": "bun run maplibre:worker && next build",
		"check": "bun run format && bun run lint",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"dev": "bun run maplibre:worker && next dev",
		"email:dev": "email dev --dir src/lib/email/templates/previews --port 3001",
		"format": "oxfmt --write src",
		"lint": "oxlint",
		"maplibre:worker": "mkdir -p public/maplibre && cp node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs node_modules/maplibre-gl/dist/maplibre-gl-shared.mjs public/maplibre/",
		"start": "next start",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"updates": "npx npm-check-updates --interactive --format group"
	},
	"dependencies": {
		"@2toad/profanity": "3.3.0",
		"@base-ui/react": "1.7.0",
		"@better-auth/drizzle-adapter": "1.7.2",
		"@better-auth/mcp": "1.7.2",
		"@better-auth/oauth-provider": "1.7.2",
		"@better-auth/passkey": "1.7.2",
		"@date-fns/tz": "1.5.0",
		"@hookform/resolvers": "5.9.1",
		"@maplibre/maplibre-gl-style-spec": "26.4.2",
		"@modelcontextprotocol/server": "^2.0.0",
		"@neondatabase/serverless": "1.1.0",
		"@react-email/components": "1.0.12",
		"@react-email/render": "2.1.0",
		"@vercel/analytics": "2.0.1",
		"better-auth": "1.7.2",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"date-fns": "4.4.0",
		"drizzle-orm": "0.45.2",
		"lucide-react": "1.34.0",
		"maplibre-gl": "6.9.0",
		"motion": "13.1.1",
		"next": "16.3.2",
		"react": "19.2.8",
		"react-day-picker": "10.0.1",
		"react-dom": "19.2.8",
		"react-hook-form": "7.86.0",
		"resend": "6.22.0",
		"server-only": "0.0.1",
		"shadcn": "4.19.0",
		"sonner": "2.0.8",
		"tailwind-merge": "3.6.0",
		"three": "0.185.1",
		"tw-animate-css": "1.4.0",
		"zod": "4.4.3",
		"zustand": "5.0.15"
	},
	"devDependencies": {
		"@better-auth/cli": "1.4.21",
		"@react-email/ui": "6.9.3",
		"@tailwindcss/postcss": "4.3.3",
		"@types/bun": "1.4.0",
		"@types/node": "26.2.0",
		"@types/react": "19.2.18",
		"@types/react-dom": "19.2.5",
		"@types/three": "0.185.4",
		"drizzle-kit": "0.31.10",
		"oxfmt": "0.65.0",
		"oxlint": "1.80.0",
		"react-email": "6.9.3",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2"
	}
}
